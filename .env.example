# ==============================================================================
# COSMOCLIP — Root Environment Configuration Template
# ==============================================================================

# --- Google Gemini Live Voice Interaction (Optional) ---
# Required for real-time bidirectional voice streaming features.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# --- Mistral Cloud Vision-Language Reasoning (Optional) ---
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Copernicus Data Space Ecosystem (CDSE) STAC API ---
# Base STAC search endpoint for Sentinel-2 L2A optical catalogs
CDSE_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac/search
CDSE_USERNAME=
CDSE_PASSWORD=

# --- Server & Port Settings ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Remote Sensing VLM Specialist Model Execution ---
RS_VLM_DEVICE=cpu
RS_VLM_MODEL_ID=BigData-KSU/RS-LLaVA-7B
RS_VLM_MAX_TOKENS=128
RS_VLM_TEMPERATURE=0.0
