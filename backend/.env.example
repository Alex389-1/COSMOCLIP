# ==============================================================================
# SatQuery AI — Backend Environment Configuration (.env)
# ==============================================================================

# Google Gemini API Key for Gemini 3.1 Flash Live Preview voice layer (Optional)
GEMINI_API_KEY=

# Model identifier for Gemini Live dialogue
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Copernicus Data Space Ecosystem (CDSE) STAC Catalog API
CDSE_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac/search

# Optional CDSE credentials for direct product downloads
CDSE_USERNAME=
CDSE_PASSWORD=

# FastAPI host and port
HOST=0.0.0.0
PORT=8000

# Specialist RS-LLaVA runtime configuration
RS_VLM_DEVICE=cpu
RS_VLM_MODEL_ID=BigData-KSU/RS-LLaVA-7B
RS_VLM_MAX_TOKENS=128
RS_VLM_TEMPERATURE=0.0
